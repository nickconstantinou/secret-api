[Unit]
Description=Provider-neutral Secret API service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=secret-api
Group=secret-api
WorkingDirectory=/srv/secret-api/current
EnvironmentFile=/etc/secret-api/llm-api.env
Environment=HOME=/var/lib/secret-api
ExecStart=/usr/bin/env node api/index.js
Restart=on-failure
RestartSec=5s
KillSignal=SIGTERM
TimeoutStopSec=6min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/secret-api
UMask=0077

# This template intentionally has no [Install] section. Installation and
# activation require a separate, supervised production procedure.
