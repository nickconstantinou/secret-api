API_HOST=127.0.0.1
API_PORT=8787
HOME=/var/lib/secret-api
CLIENT_KEYS_FILE=/etc/secret-api/client-keys.json
LLM_PROVIDER=agy
MAX_BODY_BYTES=131072
MAX_PROMPT_CHARS=120000
MAX_PROMPT_BYTES=120000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_COUNT=10
MAX_ACTIVE_CALLS=1
MAX_QUEUE_SIZE=4
PROVIDER_TIMEOUT_MS=300000
AGY_CLI_PATH=/path/to/agy
AGY_WORK_DIR=/var/lib/secret-api/agy-work
AGY_MODEL=replace-with-approved-model
AGY_MAX_ARGUMENT_BYTES=120000
AGY_MAX_OUTPUT_BYTES=1048576
